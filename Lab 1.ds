/*
 * Author       : keerthana.c.2024.cse_raja541
 * Generated on : 10-Nov-2026 09:36:18
 * Version      : 1.0
 */
 application "Hotel Room Booking Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form room_booking_form
		{
			displayname = "Room Booking Form"
			success message = "Booking request submitted successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have guest_name
			(
    			type = name
				displayname = "Guest Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			section_scheduling
			(
				type = section
				displayname = "Scheduling & Policy Acknowledgement"
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have email_address
			(
    			type = email
				displayname = "Email Address"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
			)
			permanent_address
			(
    			type = address
				displayname = "Permanent Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
     			) 
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have contact_number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have id_proof_number
			(
    			type = text
				displayname = "ID Proof Number"
	 			row = 2
	 			column = 1   
				width = medium
			)
			special_requests
			(
    			type = textarea
				displayname = "Special Requests"
				height = 13px
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have number_of_guests
			(
				type = number
				displayname = "Number of Guests"
				maxchar = 1
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have check_in_date
			(
    			type = date
				displayname = "Check-In Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			preferred_checkin_time
			(
    			type = time
				displayname = "Preferred Check-in Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have room_type
			(
				type = picklist
				displayname = "Room Type"
				maxchar = 100
				values = {"Deluxe Double Room","Standard Single Room","Suite","Twin Room"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have meal_plan
			(
				type = radiobuttons
				displayname = "Meal Plan"
				maxchar = 100
				values = {"Room Only","Breakfast Included","All Meals Included"}
				layout = 3
	 			row = 2
	 			column = 1   
				width = medium
			)
			section_room_preferences
			(
				type = section
				displayname = "Room & Stay Preferences"
	 			row = 3
	 			column = 0   
				width = medium
			)
			amenities_required
			(
				type = checkboxes	
				displayname = "Amenities Required"
				values = {"Extra Bed","Airport Pickup","Late Checkout","High Floor","Non-Smoking"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have agree_to_policies
			(
    			type = checkbox
				displayname = "Agree to Hotel Policies"
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			section_contact_details
			(
				type = section
				displayname = "Contact Details"
	 			row = 4
	 			column = 0   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list room_booking_report
		{
			displayName = "Room Booking Report"
			show all rows from room_booking_form    
			(
				guest_name  as "Guest Name"
	 			(
	      			displayformat = [first_name+""+last_name]
	 			)
				id_proof_number as "ID Proof Number"
				number_of_guests as "Number of Guests"
				email_address as "Email Address"
				contact_number as "Contact Number"
				(
					displayformat = formattednumber 
				)
				permanent_address  as "Permanent Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				room_type as "Room Type"
				meal_plan as "Meal Plan"
				amenities_required as "Amenities Required"
				(
					delimiter = comma
				)
				special_requests as "Special Requests"
				check_in_date as "Check-In Date"
				(
					displayformat = fulldate
				)
				preferred_checkin_time as "Preferred Check-in Time"
				agree_to_policies as "Agree to Hotel Policies"
				(
						displaytrue = "Yes"
						displayfalse = "No"
				)
			)
			filters
			(
				room_type
				check_in_date
				"Upcoming Bookings"  :  check_in_date >= today
			)
			sort by
			(
				check_in_date ascending
			)
		}
	}




	share_settings
	{
			"Read"
			{
				name = "Read"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have read permission for all components\n"
			}
			"Write"
			{
				name = "Write"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have write permission for all components\n"
			}
			"Developer"
			{
				name = "Developer"
				type = Developer
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Developer Profile\n"
			}
			"Administrator"
			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"Customer"
			{
				name = "Customer"
				type = Customer_Portal
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This is the default profile having only add and view permission.\n"
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}


	web
	{
		forms
		{
			form room_booking_form
			{
				label placement = left
			}
		}
		reports
		{
			report room_booking_report
			{
				quickview
				(
					layout
					(
						quick_view
						(
							fields
							(
								guest_name as "Guest Name"
								room_type as "Room Type"
								check_in_date as "Check-In Date"
								number_of_guests as "Number of Guests"
								contact_number as "Contact Number"
							)
						)
					)
						menu
						(
							header
							(
							)
						record
						(
							Edit   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						booking_details
						(
		     				title = "Booking Details"
							fields
							(
								guest_name as "Guest Name"
								id_proof_number as "ID Proof Number"
								number_of_guests as "Number of Guests"
								email_address as "Email Address"
								contact_number as "Contact Number"
								permanent_address as "Permanent Address"
								room_type as "Room Type"
								meal_plan as "Meal Plan"
								amenities_required as "Amenities Required"
								special_requests as "Special Requests"
								check_in_date as "Check-In Date"
								preferred_checkin_time as "Preferred Check-in Time"
								agree_to_policies as "Agree to Hotel Policies"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
							)
						)
				)
			}
		}
		menu
		{
			space Space
			{
				displayname = "Space"
				icon = "objects-spaceship"

				section ZC_App_Preferences
				{
					displayname = "App Preferences"
					icon = "design-app"
					systemcomponent
					{
						type = localization
						displayname = "Language Selection"
						icon = "education-language"
					}
					systemcomponent
					{
						type = connection
						displayname = "Integrations"
						icon = "tech-2-connection"
					}
				}
				section ZC_Approvals
				{
					displayname = "Approvals"
					icon = "ui-2-hourglass"
					systemcomponent
					{
						type = approval
						approval status = pending
						displayname = "Pending Tasks"
						icon = "ui-2-hourglass"
					}
					systemcomponent
					{
						type = approval
						approval status = completed
						displayname = "Completed Tasks"
						icon = "design-todo"
					}
				}
				section SharedAnalytics_Section
				{
					type = shared_user_report_section
					displayname = "Reports"
					icon = "business-chart-bar-33"
				}
				section room_bookings_section
				{
					displayname = "Room Bookings"
					icon = "tech-desktop"
					form  room_booking_form
					{
						icon = "tech-desktop"
					}
					report room_booking_report
					{
						icon = "tech-desktop"
					}
				}
			}
			preference
			{
				icon
				{
					style = solid
					show = {space,section,component}
				}
			}
		}
		customize
		{
			new theme = 6
			font = "rubik"
			color options
			{
				color = "7"
			}
			logo
			{
				preference = "none"
				placement = "left"
			}
		}
	}
	phone
	{
		customize
		{
			layout = twocolumn
			font = "default"
			style = "3"
			color options
			{
				color = chryslerpurple
			}
			logo
			{
				preference = "none"
			}
		}
	}
	tablet
	{
		customize
		{
			layout = slidingpane
			font = "default"
			style = "3"
			color options
			{
				color = yellow
			}
			logo
			{
				preference = "none"
			}
		}
	}
	translation
{
{"Language_Settings":{"LANGAGUE_WITH_LOGIN":"browser"}}
}
}
